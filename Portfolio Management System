# ------- Editor Functions -----------
def open_field_editor(root, user_id, field_name):
    win = tk.Toplevel(root)
    win.title(f"Edit {field_name}")
    win.configure(bg=BG_COLOR)
    
    tk.Label(win, text=f"Edit {field_name}", font=("Arial", 14, "bold"), bg=BG_COLOR, fg=HEADER_COLOR).pack(pady=(20, 5))
    
    text_frame = tk.Frame(win, bg=BG_COLOR)
    text_frame.pack(padx=20, pady=10)
    
    text_box = tk.Text(text_frame, height=10, width=50, font=("Arial", 10), bg="white", fg="black")
    text_box.pack(side=tk.LEFT, padx=(0, 5))
    
    scrollbar = tk.Scrollbar(text_frame, command=text_box.yview)
    scrollbar.pack(side=tk.RIGHT, fill=tk.Y)
    text_box.config(yscrollcommand=scrollbar.set)
    
    # Load existing content
    cursor.execute(f"SELECT {field_name.lower()} FROM Portfolio WHERE user_id = %s", (user_id,))
    result = cursor.fetchone()
    if result and result[0]:
        text_box.insert(tk.END, result[0])

    button_frame = tk.Frame(win, bg=BG_COLOR)
    button_frame.pack(pady=10)
    
    def save_field():
        content = text_box.get("1.0", tk.END).strip()
        cursor.execute(f"SELECT user_id FROM Portfolio WHERE user_id = %s", (user_id,))
        exists = cursor.fetchone()
        if exists:
            cursor.execute(f"UPDATE Portfolio SET {field_name.lower()} = %s WHERE user_id = %s", (content, user_id))
        else:
            cursor.execute(f"INSERT INTO Portfolio (user_id, {field_name.lower()}) VALUES (%s, %s)", (user_id, content))
        conn.commit()
        messagebox.showinfo("Saved", f"{field_name} updated successfully!")
        win.destroy()

    create_button(button_frame, "Save", save_field).pack(side=tk.LEFT, padx=10)
    create_button(button_frame, "Cancel", win.destroy).pack(side=tk.LEFT, padx=10)

def open_crud_editor(root, user_id, table_name, field_name):
    win = tk.Toplevel(root)
    win.title(f"Manage {field_name.capitalize()}")
    win.configure(bg=BG_COLOR)
    
    main_frame = tk.Frame(win, bg=BG_COLOR)
    main_frame.pack(padx=20, pady=10)
    
    tk.Label(main_frame, text=f"Manage {field_name.capitalize()}", 
            font=("Arial", 14, "bold"), bg=BG_COLOR, fg=HEADER_COLOR).grid(row=0, column=0, columnspan=2, pady=10)
    
    # Entry Frame
    entry_frame = tk.Frame(main_frame, bg=BG_COLOR)
    entry_frame.grid(row=1, column=0, columnspan=2, pady=10)
    
    tk.Label(entry_frame, text="Year:", bg=BG_COLOR, fg=TEXT_COLOR).grid(row=0, column=0, sticky="e", padx=5, pady=5)
    year_entry = tk.Entry(entry_frame, font=("Arial", 10), fg="black")
    year_entry.grid(row=0, column=1, padx=5, pady=5)
    
    tk.Label(entry_frame, text=f"{field_name.capitalize()}:", bg=BG_COLOR, fg=TEXT_COLOR).grid(row=1, column=0, sticky="e", padx=5, pady=5)
    field_entry = tk.Entry(entry_frame, font=("Arial", 10), fg="black")
    field_entry.grid(row=1, column=1, padx=5, pady=5)
    
    # Button Frame
    button_frame = tk.Frame(main_frame, bg=BG_COLOR)
    button_frame.grid(row=2, column=0, columnspan=2, pady=10)
    
    create_button(button_frame, f"Add {field_name.capitalize()}", add_entry, width=15).grid(row=0, column=0, padx=5, pady=5)
    create_button(button_frame, "Update Selected", update_selected, width=15).grid(row=0, column=1, padx=5, pady=5)
    create_button(button_frame, "Delete Selected", delete_selected, width=15).grid(row=1, column=0, padx=5, pady=5)
    create_button(button_frame, "Show Graph", show_graph, width=15).grid(row=1, column=1, padx=5, pady=5)
    
    # Listbox Frame with Scrollbar
    list_frame = tk.Frame(main_frame)
    list_frame.grid(row=3, column=0, columnspan=2, pady=10)
    
    scrollbar = tk.Scrollbar(list_frame)
    scrollbar.pack(side=tk.RIGHT, fill=tk.Y)
    
    listbox = tk.Listbox(list_frame, width=60, height=10, font=("Arial", 10), fg="black")
    listbox.pack(side=tk.LEFT, fill=tk.BOTH)
    
    scrollbar.config(command=listbox.yview)
    
    def refresh_list():
        listbox.delete(0, tk.END)
        cursor.execute(f"SELECT id, year, {field_name} FROM {table_name} WHERE user_id = %s", (user_id,))
        for row in cursor.fetchall():
            listbox.insert(tk.END, f"{row[0]} - {row[1]}: {row[2]}")

    def add_entry():
        year = year_entry.get()
        value = field_entry.get()
        if year.isdigit() and value:
            cursor.execute(f"INSERT INTO {table_name} (user_id, year, {field_name}) VALUES (%s, %s, %s)", (user_id, int(year), value))
            conn.commit()
            refresh_list()
            year_entry.delete(0, tk.END)
            field_entry.delete(0, tk.END)
        else:
            messagebox.showwarning("Input Error", f"Please enter a valid year and {field_name}.")

    def delete_selected():
        selection = listbox.curselection()
        if selection:
            item_text = listbox.get(selection[0])
            entry_id = int(item_text.split(" - ")[0])
            if messagebox.askyesno("Confirm Delete", "Do you want to delete this entry?"):
                cursor.execute(f"DELETE FROM {table_name} WHERE id = %s", (entry_id,))
                conn.commit()
                refresh_list()

    def update_selected():
        selection = listbox.curselection()
        if selection:
            item_text = listbox.get(selection[0])
            entry_id = int(item_text.split(" - ")[0])
            new_year = year_entry.get()
            new_value = field_entry.get()
            if messagebox.askyesno("Confirm Update", "Do you want to update this entry?"):
                if new_year.isdigit() and new_value:
                    cursor.execute(f"UPDATE {table_name} SET year = %s, {field_name} = %s WHERE id = %s", (int(new_year), new_value, entry_id))
                    conn.commit()
                    refresh_list()
                    year_entry.delete(0, tk.END)
                    field_entry.delete(0, tk.END)
                else:
                    messagebox.showwarning("Input Error", f"Please enter a valid year and {field_name}.")

    def show_graph():
        cursor.execute(f"SELECT year FROM {table_name} WHERE user_id = %s", (user_id,))
        years = [row[0] for row in cursor.fetchall()]
        if not years:
            messagebox.showinfo("No Data", f"No {field_name} data to show.")
            return
        df = pd.DataFrame(years, columns=["Year"])
        year_counts = df["Year"].value_counts().sort_index()
        plt.figure(figsize=(6,4))
        year_counts.plot(kind='bar', title=f"{field_name.capitalize()} per Year", xlabel="Year", ylabel=f"Number of {field_name.capitalize()}")
        plt.tight_layout()
        plt.show()

    refresh_list()

