def show_progress(root, user_id):
    win = tk.Toplevel(root)
    win.title("Portfolio Progress")

    fields = ["objective", "contact", "projects", "achievements"]
    progress_values = {}

    for field in fields:
        cursor.execute(f"SELECT {field} FROM Portfolio WHERE user_id = %s", (user_id,))
        result = cursor.fetchone()
        content = result[0] if result and result[0] else ""
        # Progress = percentage of content length wrt a threshold (e.g. 200 chars)
        progress = min(len(content) / 200 * 100, 100)
        progress_values[field] = progress

    # For skills count
    cursor.execute("SELECT COUNT(*) FROM Skills WHERE user_id = %s", (user_id,))
    skills_count = cursor.fetchone()[0]
    skills_progress = min(skills_count / 10 * 100, 100)  # assuming 10 skills max for 100%

    progress_values["skills"] = skills_progress

    # Display progress bars
    for idx, (field, val) in enumerate(progress_values.items()):
        tk.Label(win, text=f"{field.capitalize()} Progress: {val:.1f}%", bg=BG_COLOR, fg=TEXT_COLOR).grid(row=idx, column=0, sticky="w", padx=10, pady=5)
        canvas = tk.Canvas(win, width=200, height=20, bg='white')
        canvas.grid(row=idx, column=1, padx=10, pady=5)
        canvas.create_rectangle(0, 0, 2 * val, 20, fill='green')

# ---------------------- Class ----------------------------

class LoginApp:
    def __init__(self, root):
        self.root = root
        self.root.title("Portfolio Management System")
        self.root.geometry("400x550")
        self.init_main_screen()

    def clear_screen(self):
        for widget in self.root.winfo_children():
            widget.destroy()

    def init_main_screen(self):
        self.clear_screen()
        tk.Label(self.root, text="Welcome!", font=("Arial", 20), bg=BG_COLOR, fg=TEXT_COLOR).pack(pady=20)
        tk.Button(self.root, text="Login", command=self.login_screen, width=20, bg=BUTTON_COLOR, fg="white").pack(pady=10)
        tk.Button(self.root, text="Sign Up", command=self.signup_screen, width=20, bg=BUTTON_COLOR, fg="white").pack(pady=10)

    def signup_screen(self):
        self.clear_screen()
        tk.Label(self.root, text="Sign Up", font=("Arial", 20), bg=BG_COLOR, fg=TEXT_COLOR).pack(pady=10)

        tk.Label(self.root, text="Username", bg=BG_COLOR, fg=TEXT_COLOR).pack(pady=(5, 0))
        self.signup_user = tk.Entry(self.root, fg="black")
        self.signup_user.pack(pady=(0, 10))

        tk.Label(self.root, text="Password", bg=BG_COLOR, fg=TEXT_COLOR).pack(pady=(5, 0))
        self.signup_pass = tk.Entry(self.root, show="*", fg="black")
        self.signup_pass.pack(pady=(0, 10))

        tk.Label(self.root, text="Verify Password", bg=BG_COLOR, fg=TEXT_COLOR).pack(pady=(5, 0))
        self.verify_pass = tk.Entry(self.root, show="*", fg="black")
        self.verify_pass.pack(pady=(0, 10))

        self.pass_visible = False
        self.eye_button = tk.Button(self.root, text="👁", command=self.toggle_password_visibility, bg=BUTTON_COLOR, fg="white")
        self.eye_button.pack(pady=(5, 10))

        tk.Button(self.root, text="Create Account", command=self.signup_user_func, bg=BUTTON_COLOR, fg="white").pack(pady=5)
        tk.Button(self.root, text="Clear All", command=self.clear_signup_fields, bg=BUTTON_COLOR, fg="white").pack(pady=5)
        tk.Button(self.root, text="Back", command=self.init_main_screen, bg=BUTTON_COLOR, fg="white").pack(pady=10)

    def toggle_password_visibility(self):
        self.pass_visible = not self.pass_visible
        show = "" if self.pass_visible else "*"
        self.signup_pass.config(show=show)
        self.verify_pass.config(show=show)
        self.eye_button.config(text="🙈" if self.pass_visible else "👁")

    def clear_signup_fields(self):
        self.signup_user.delete(0, tk.END)
        self.signup_pass.delete(0, tk.END)
        self.verify_pass.delete(0, tk.END)

    def signup_user_func(self):
        user = self.signup_user.get()
        pwd = self.signup_pass.get()
        verify = self.verify_pass.get()

        if pwd != verify:
            messagebox.showerror("Error", "Passwords do not match.")
            return

        if not is_strong_password(pwd):
            messagebox.showwarning("Weak Password", "Password must be 8+ chars with upper, lower, digit, and symbol.")
            return

        cursor.execute("SELECT * FROM Users WHERE username = %s", (user,))
        if cursor.fetchone():
            messagebox.showerror("Error", "Username already exists.")
            return

        hashed_pwd = hash_password(pwd)
        cursor.execute("INSERT INTO Users (username, password) VALUES (%s, %s)", (user, hashed_pwd))
        conn.commit()
        messagebox.showinfo("Success", "Account created successfully!")
        self.init_main_screen()

    def login_screen(self):
        self.clear_screen()
        tk.Label(self.root, text="Login", font=("Arial", 16), bg=BG_COLOR, fg=TEXT_COLOR).pack(pady=10)

        tk.Label(self.root, text="Username", bg=BG_COLOR, fg=TEXT_COLOR).pack(pady=(5, 0))
        self.login_user = tk.Entry(self.root, fg="black")
        self.login_user.pack(pady=(0, 10))

        tk.Label(self.root, text="Password", bg=BG_COLOR, fg=TEXT_COLOR).pack(pady=(5, 0))
        self.login_pass = tk.Entry(self.root, show="*", fg="black")
        self.login_pass.pack(pady=(0, 10))

        self.login_pass_visible = False
        self.login_eye_button = tk.Button(self.root, text="👁", command=self.toggle_login_password, bg=BUTTON_COLOR, fg="white")
        self.login_eye_button.pack(pady=(5, 10))

        tk.Button(self.root, text="Login", command=self.login_user_func, bg=BUTTON_COLOR, fg="white").pack(pady=5)
        tk.Button(self.root, text="Clear All", command=self.clear_login_fields, bg=BUTTON_COLOR, fg="white").pack(pady=5)
        tk.Button(self.root, text="Back", command=self.init_main_screen, bg=BUTTON_COLOR, fg="white").pack(pady=10)

    def toggle_login_password(self):
        self.login_pass_visible = not self.login_pass_visible
        show = "" if self.login_pass_visible else "*"
        self.login_pass.config(show=show)
        self.login_eye_button.config(text="🙈" if self.login_pass_visible else "👁")

    def clear_login_fields(self):
        self.login_user.delete(0, tk.END)
        self.login_pass.delete(0, tk.END)

    def login_user_func(self):
        user = self.login_user.get()
        pwd = hash_password(self.login_pass.get())

        cursor.execute("SELECT id FROM Users WHERE username = %s AND password = %s", (user, pwd))
        result = cursor.fetchone()
        if result:
            self.user_id = result[0]
            self.show_portfolio(user)
        else:
            messagebox.showerror("Error", "Invalid username or password.")

    def show_portfolio(self, username):
        self.clear_screen()
        tk.Label(self.root, text=f"Welcome, {username}", font=("Arial", 25), bg=BG_COLOR, fg=HEADER_COLOR).pack(pady=10)

        buttons = [
            ("Objective", lambda: open_field_editor(self.root, self.user_id, "Objective")),
            ("Contact Details", lambda: open_field_editor(self.root, self.user_id, "Contact")),
            ("Skills", lambda: open_skills_editor(self.root, self.user_id)),
            ("Projects", lambda: open_projects_editor(self.root, self.user_id)),
            ("Achievements", lambda: open_achievements_editor(self.root, self.user_id)),
            ("Show Progress", lambda: show_progress(self.root, self.user_id))
        ]

        for label, command in buttons:
            tk.Button(self.root, text=label, width=30, command=command, bg=BUTTON_COLOR, fg="white").pack(pady=5)

        tk.Button(self.root, text="Logout", command=self.init_main_screen, bg=BUTTON_COLOR, fg="white").pack(pady=10)

