import tkinter as tk
from tkinter import messagebox, scrolledtext, ttk
from collections import Counter

# ----------------------------
# HuffmanNode Definition
# ----------------------------
class HuffmanNode:
    def __init__(self, char=None, freq=0):
        self.char = char
        self.freq = freq
        self.left = None
        self.right = None

    def __lt__(self, other):
        return self.freq < other.freq

# ----------------------------
# Huffman Compression Logic
# ----------------------------
def build_frequency_table(text):
    return Counter(text)

def build_huffman_tree(freq_table):
    nodes = [HuffmanNode(char, freq) for char, freq in freq_table.items()]
    while len(nodes) > 1:
        nodes.sort(key=lambda x: x.freq)
        node1 = nodes.pop(0)
        node2 = nodes.pop(0)
        merged = HuffmanNode(freq=node1.freq + node2.freq)
        merged.left = node1
        merged.right = node2
        nodes.append(merged)
    return nodes[0]

def build_codes(node, prefix="", codebook=None):
    if codebook is None:
        codebook = {}
    if node:
        if node.char is not None:
            codebook[node.char] = prefix
        build_codes(node.left, prefix + "0", codebook)
        build_codes(node.right, prefix + "1", codebook)
    return codebook

def compress(text, codebook):
    return ''.join(codebook[char] for char in text)

def huffman_compress(text):
    freq_table = build_frequency_table(text)
    root = build_huffman_tree(freq_table)
    codebook = build_codes(root)
    encoded = compress(text, codebook)
    return encoded, codebook

# ----------------------------
# GUI Logic
# ----------------------------
def compress_text():
    text = input_text.get("1.0", tk.END).strip()
    if not text:
        messagebox.showwarning("Input Error", "Please enter some text to compress.")
        return

    encoded, codebook = huffman_compress(text)

    # Show encoded binary
    output_text.delete("1.0", tk.END)
    output_text.insert(tk.END, encoded)

    # Clear existing table
    for i in codebook_table.get_children():
        codebook_table.delete(i)

    # Insert new codebook entries
    for char, code in codebook.items():
        display_char = repr(char)[1:-1]  # shows '\n' or '\t' etc. nicely
        codebook_table.insert("", "end", values=(display_char, code))

