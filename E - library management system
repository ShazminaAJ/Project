// ---------------- MANAGE BOOKS ----------------

class BookManager extends JFrame {

    JTable table;
    DefaultTableModel model;

    JTextField id;
    JTextField tit;
    JTextField auth;

    BookManager() {

        setTitle("Book Manager");
        setSize(600, 400);
        setLayout(new BorderLayout());

        model = new DefaultTableModel(
                new String[]{"ID", "Title", "Author"}, 0);

        table = new JTable(model);

        load();

        JPanel p = new JPanel(new GridLayout(4, 2));

        id = new JTextField();
        tit = new JTextField();
        auth = new JTextField();

        p.add(new JLabel("ID"));
        p.add(id);

        p.add(new JLabel("Title"));
        p.add(tit);

        p.add(new JLabel("Author"));
        p.add(auth);

        JButton add = new JButton("Add");
        JButton del = new JButton("Delete");

        add.addActionListener(e -> addBook());
        del.addActionListener(e -> delBook());

        p.add(add);
        p.add(del);

        add(new JScrollPane(table), BorderLayout.CENTER);
        add(p, BorderLayout.SOUTH);

        setVisible(true);
    }

    void load() {

        model.setRowCount(0);

        try (
                Connection c = DB.connect();
                Statement s = c.createStatement();
                ResultSet r = s.executeQuery("SELECT * FROM Books")
        ) {

            while (r.next()) {

                model.addRow(new Object[]{
                        r.getInt(1),
                        r.getString(2),
                        r.getString(3)
                });
            }

        } catch (Exception ex) {

            ex.printStackTrace();
        }
    }

    void addBook() {

        try (
                Connection c = DB.connect();
                PreparedStatement p = c.prepareStatement(
                        "INSERT INTO Books VALUES(?,?,?)")
        ) {

            p.setInt(1, Integer.parseInt(id.getText()));
            p.setString(2, tit.getText());
            p.setString(3, auth.getText());

            p.executeUpdate();

            load();

        } catch (Exception e) {

            e.printStackTrace();
        }
    }

    void delBook() {

        try (
                Connection c = DB.connect();
                PreparedStatement p = c.prepareStatement(
                        "DELETE FROM Books WHERE ID=?")
        ) {

            p.setInt(1, Integer.parseInt(id.getText()));

            p.executeUpdate();

            load();

        } catch (Exception e) {

            e.printStackTrace();
        }
    }
}
