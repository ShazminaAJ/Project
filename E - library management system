// ---------------- ISSUE / RETURN ----------------

class IssueReturn extends JFrame {

    JTextField bookID;
    JTextField userID;

    DefaultTableModel model;
    JTable table;

    IssueReturn() {

        setTitle("Issue/Return");
        setSize(600, 400);
        setLayout(new BorderLayout());

        model = new DefaultTableModel(
                new String[]{"BookID", "UserID", "IssueDate", "ReturnDate"}, 0);

        table = new JTable(model);

        load();

        JPanel p = new JPanel(new GridLayout(3, 2));

        bookID = new JTextField();
        userID = new JTextField();

        p.add(new JLabel("Book ID"));
        p.add(bookID);

        p.add(new JLabel("User ID"));
        p.add(userID);

        JButton issue = new JButton("Issue");
        JButton ret = new JButton("Return");

        issue.addActionListener(e -> issueBook());
        ret.addActionListener(e -> returnBook());

        p.add(issue);
        p.add(ret);

        add(new JScrollPane(table), BorderLayout.CENTER);
        add(p, BorderLayout.SOUTH);

        setVisible(true);
    }

    void load() {

        model.setRowCount(0);

        try (
                Connection c = DB.connect();
                Statement s = c.createStatement();
                ResultSet r = s.executeQuery("SELECT * FROM IssueTable")
        ) {

            while (r.next()) {

                model.addRow(new Object[]{
                        r.getInt(1),
                        r.getInt(2),
                        r.getString(3),
                        r.getString(4)
                });
            }

        } catch (Exception e) {

            e.printStackTrace();
        }
    }

    void issueBook() {

        try (
                Connection c = DB.connect();
                PreparedStatement p = c.prepareStatement(
                        "INSERT INTO IssueTable(BookID,UserID,IssueDate) VALUES(?,?,DATE())")
        ) {

            p.setInt(1, Integer.parseInt(bookID.getText()));
            p.setInt(2, Integer.parseInt(userID.getText()));

            p.executeUpdate();

            load();

        } catch (Exception e) {

            e.printStackTrace();
        }
    }

    void returnBook() {

        try (
                Connection c = DB.connect();
                PreparedStatement p = c.prepareStatement(
                        "UPDATE IssueTable SET ReturnDate=DATE() WHERE BookID=? AND UserID=?")
        ) {

            p.setInt(1, Integer.parseInt(bookID.getText()));
            p.setInt(2, Integer.parseInt(userID.getText()));

            p.executeUpdate();

            load();

        } catch (Exception e) {

            e.printStackTrace();
        }
    }
}

// ---------------- LATE FEE REPORT ----------------

class LateFeeReport extends JFrame {

    JTextArea area;

    LateFeeReport() {

        setTitle("Late Fees");
        setSize(400, 300);

        area = new JTextArea();

        add(new JScrollPane(area));

        gen();

        setVisible(true);
    }

    void gen() {

        StringBuilder sb = new StringBuilder();

        try (
                Connection c = DB.connect();
                Statement s = c.createStatement();
                ResultSet r = s.executeQuery(
                        "SELECT * FROM IssueTable WHERE ReturnDate IS NOT NULL")
        ) {

            while (r.next()) {

                int days = (int) (Math.random() * 10) + 1;

                int fee = days > 7 ? (days - 7) * 5 : 0;

                sb.append("Book ")
                  .append(r.getInt(1))
                  .append(" User ")
                  .append(r.getInt(2))
                  .append(" -> Rs.")
                  .append(fee)
                  .append("\n");
            }

        } catch (Exception e) {

            e.printStackTrace();
        }

        area.setText(sb.toString());
    }
}
